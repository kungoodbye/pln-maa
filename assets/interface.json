{
    "interface_version": 2,
    "name": "pln-auto",
    "description": "飘流幻境新世界自动化",
    "license": "MIT",
    "github": "https://github.com/kungoodbye/pln-maa",
    "version": "0.1.0",
    "controller": [
        {
            "name": "Win32",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "飘流幻境新世界",
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "默认",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "连续炼金",
            "entry": "Alchemy.EnsureUI",
            "default_check": true,
            "description": "第一屏自动补充小齿轮与草菇或小石头并连续合成，任一必需材料耗尽后正常停止"
        }
    ]
}
