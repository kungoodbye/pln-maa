{
    "interface_version": 2,
    "name": "pln-auto",
    "description": "飘流幻境新世界自动化",
    "license": "MIT",
    "github": "https://github.com/kungoodbye/pln-maa",
    "version": "0.1.0",
    "controller": [
        {
            "name": "雷电模拟器（ADB）",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "雷电模拟器 14（ADB）",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "雷电模拟器 9（ADB）",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "Win32",
            "type": "Win32",
            "display_short_side": 720,
            "win32": {
                "class_regex": "UnityWndClass",
                "window_regex": "飘流幻境新世界",
                "screencap": "FramePool",
                "mouse": "Seize",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "默认",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "连续炼金",
            "entry": "Alchemy.EnsureUI",
            "default_check": true,
            "description": "自动补充小齿轮或柴薪作为主材，并使用馒头、草菇或普通石块作为副材连续合成；副料未找到时向上搜索一屏"
        },
        {
            "name": "回收小鸡腿",
            "entry": "Recycle.OpenBin",
            "default_check": false,
            "description": "自动打开资源回收桶，最多下滑三次回收所有小鸡腿；找不到时正常结束"
        },
        {
            "name": "玩家对战",
            "entry": "Arena.EnsureUI",
            "default_check": false,
            "description": "自动检测活力值并在不足时花费绿钻补至 5 点，自动参与玩家对战，开启 AI 自动战斗并循环进行；支持自定义超时限制与最大场次",
            "option": [
                "ArenaBattleTimeout",
                "ArenaMaxRounds"
            ]
        }
    ],
    "option": {
        "ArenaBattleTimeout": {
            "type": "select",
            "label": "单场战斗最高超时限制",
            "description": "单场战斗在场景中的最大等待时长，超时后将安全结束当前战斗",
            "default_case": "5min",
            "cases": [
                {
                    "name": "3min",
                    "label": "3 分钟 (180 秒)",
                    "pipeline_override": {
                        "Arena.CheckAutoBattleOn": {
                            "timeout": 180000
                        },
                        "Arena.WaitBattleEnd": {
                            "timeout": 180000
                        }
                    }
                },
                {
                    "name": "5min",
                    "label": "5 分钟 (300 秒 - 默认推荐)",
                    "pipeline_override": {
                        "Arena.CheckAutoBattleOn": {
                            "timeout": 300000
                        },
                        "Arena.WaitBattleEnd": {
                            "timeout": 300000
                        }
                    }
                },
                {
                    "name": "10min",
                    "label": "10 分钟 (600 秒)",
                    "pipeline_override": {
                        "Arena.CheckAutoBattleOn": {
                            "timeout": 600000
                        },
                        "Arena.WaitBattleEnd": {
                            "timeout": 600000
                        }
                    }
                }
            ]
        },
        "ArenaMaxRounds": {
            "type": "input",
            "label": "最大对战轮数",
            "description": "达到指定轮数后自动停止对战；填 0 表示无限循环",
            "inputs": [
                {
                    "name": "max_rounds",
                    "label": "对战轮次 (0 为无限循环)",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^[0-9]+$",
                    "pattern_msg": "请输入有效的非负整数"
                }
            ]
        }
    }
}
